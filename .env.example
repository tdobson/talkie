# Where videos, sessions and comments are stored (plain files on disk).
DATA_DIR=./data

# Groq Whisper transcription. The key only ever comes from the environment.
GROQ_API_KEY=
WHISPER_LANGUAGE=en
# Set to "fake" in tests to skip the network. With NODE_ENV=production "fake" is
# refused unless E2E_TEST_MODE=1 is also set, and "groq" needs GROQ_API_KEY.
TRANSCRIBER=groq

# Admin routes sit behind Cloudflare Access. "off" is refused in production.
ADMIN_AUTH=cloudflare
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Used to build review links. Required in production.
PUBLIC_BASE_URL=http://localhost:3000
