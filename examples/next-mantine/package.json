{
  "name": "@talkie/example-next-mantine",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "copy-film": "node scripts/copy-film.mjs",
    "predev": "yarn copy-film",
    "prebuild": "yarn copy-film",
    "dev": "yarn predev && ../../scripts/low next dev",
    "build": "yarn prebuild && ../../scripts/low next build",
    "analyze": "yarn prebuild && ANALYZE=true ../../scripts/low next build",
    "start": "../../scripts/low next start",
    "typecheck": "../../scripts/low tsc --noEmit",
    "lint": "yarn oxlint && yarn stylelint",
    "oxlint": "../../scripts/low oxlint -c oxlint.config.mjs .",
    "stylelint": "../../scripts/low stylelint \"**/*.css\" --cache",
    "jest": "../../scripts/low jest --maxWorkers=2",
    "jest:watch": "../../scripts/low jest --maxWorkers=2 --watch",
    "format:test": "../../scripts/low oxfmt -c oxfmt.config.mjs --check \"**/*.{ts,tsx,css}\"",
    "format:write": "../../scripts/low oxfmt -c oxfmt.config.mjs --write \"**/*.{ts,tsx,css}\"",
    "test": "../../scripts/low next typegen && yarn format:test && yarn lint && yarn typecheck && yarn jest",
    "storybook": "../../scripts/low storybook dev -p 6006",
    "storybook:build": "../../scripts/low storybook build"
  },
  "dependencies": {
    "@mantine/core": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@next/bundle-analyzer": "^16.0.0",
    "@tabler/icons-react": "^3.35.0",
    "@talkie/react": "workspace:*",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@storybook/addon-themes": "^10.0.0",
    "@storybook/nextjs": "^10.0.0",
    "@storybook/react": "^10.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "19.3.0",
    "babel-loader": "^10.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "oxc-config-mantine": "^1.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.70.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "storybook": "^10.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "ts-jest": "^29.4.4",
    "typescript": "7.0.2"
  }
}
