# The front door: Caddy on 127.0.0.1:3000 (where the Cloudflare tunnel sends traffic), passing
# every request to whichever app slot is running (see the Caddyfile). Its config never changes
# during a deploy, and it is never reloaded: the Caddy 2.6.2 on geriatrix panics on a reload.
# This Caddy is separate from any other on the machine: its own config, its own admin socket,
# no TLS.
# Installed by scripts/deploy/video-feedback.sh. See docs/DEPLOY.md.

[Unit]
Description=Video feedback front proxy (Caddy on 127.0.0.1:3000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tdobson
Environment=XDG_DATA_HOME=/srv/video-feedback/proxy/data XDG_CONFIG_HOME=/srv/video-feedback/proxy/config
ExecStart=/usr/bin/caddy run --environ=false --config /srv/video-feedback/proxy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
