# Installed and kept up to date by scripts/deploy/video-feedback.sh (it copies this file to
# /etc/systemd/system/ when it changes). See docs/DEPLOY.md.
#
# /srv/video-feedback/current points at the live release: a standalone build that mirrors the repo
# from its root, so the server lives in apps/video-feedback inside it.

[Unit]
Description=Video feedback (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tdobson
WorkingDirectory=/srv/video-feedback/current/apps/video-feedback
# Secrets and site settings, including TALKIE_CHROMIUM_PATH (the headless Chromium for Talkie
# stills, set by the deploy script). Values in this file win over the Environment= line below,
# so do not set NODE_ENV, HOSTNAME or PORT in it.
EnvironmentFile=/srv/video-feedback/env
Environment=NODE_ENV=production HOSTNAME=127.0.0.1 PORT=3000
ExecStart=/usr/local/bin/node server.js
Restart=on-failure
RestartSec=5
# Next.js exits 143 after a clean SIGTERM (128 + 15). That is a normal stop, not a failure.
SuccessExitStatus=143
Nice=0
# ffmpeg, sharp and Chromium work is lowered per process by lib/media/run.ts (ionice -c2 -n7 nice -n19)

[Install]
WantedBy=multi-user.target
