{
  "name": "@talkie/author",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "description": "Talkie authoring library: scene code to Lottie JSON",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "../../scripts/low esbuild src/index.ts --bundle --format=esm --platform=node --packages=external --outfile=dist/index.js && ../../scripts/low tsc -p tsconfig.json"
  },
  "dependencies": {
    "opentype.js": "^2.0.0",
    "svgpath": "^2.6.0",
    "svgson": "^5.3.1"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10"
  }
}
